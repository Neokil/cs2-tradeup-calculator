# Steam Market rate limit (ms between requests)
STEAM_RATE_LIMIT_MS=3000

# Price refresh interval (cron expression, default every 4 hours)
PRICE_REFRESH_CRON=0 */4 * * *

# Minimum ROI threshold to show in results (percentage)
MIN_ROI_THRESHOLD=100

# Maximum number of results to show
MAX_RESULTS=50

# Steam marketplace tax rate (decimal)
STEAM_TAX_RATE=0.13

# CSFloat API key (optional) — enables per-phase Doppler prices
# Get yours at: https://csfloat.com/developer
CSFLOAT_API_KEY=
