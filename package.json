{
  "name": "cs2-tradeup-calculator",
  "version": "1.0.0",
  "description": "CS2 Trade-Up Calculator - Find the most profitable trade-up contracts",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "cs2-tradeup": "src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "tsx src/index.ts sync",
    "scan": "tsx src/index.ts scan",
    "watch": "tsx src/index.ts watch"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "express": "^5.2.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
